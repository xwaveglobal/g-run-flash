{
  "name": "run-flash",
  "private": true,
  "version": "3.0.0",
  "description": "Run Flash (Sky Roadster) — 3D flying-car endless runner: native TikTok mini game (v3) + web build (Three.js + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:fairness": "node --experimental-transform-types --no-warnings tests/fairness.test.ts",
    "test:difficulty": "node --experimental-transform-types --no-warnings tests/difficulty.test.ts",
    "test": "npm run test:fairness && npm run test:difficulty && npm run test:air && npm run test:exp && npm run test:phases && npm run test:bonus && npm run test:server && npm run test:car && npm run test:camera && npm run test:motion && npm run test:env && npm run test:airdash",
    "test:air": "node --experimental-transform-types --no-warnings tests/airlane.test.ts",
    "test:exp": "node --experimental-transform-types --no-warnings tests/exp.test.ts",
    "test:phases": "node --experimental-transform-types --no-warnings tests/phases.test.ts",
    "test:bonus": "node --experimental-transform-types --no-warnings tests/bonus.test.ts",
    "test:server": "node --experimental-transform-types --no-warnings tests/server.test.ts",
    "test:car": "node --experimental-transform-types --no-warnings tests/car.test.ts",
    "build:car": "node scripts/car/build-x1.mjs",
    "preview:car": "node scripts/car/preview-x1.mjs",
    "test:camera": "node --experimental-transform-types --no-warnings tests/camera.test.ts",
    "test:motion": "node --experimental-transform-types --no-warnings tests/carMotion.test.ts",
    "test:vfx": "node scripts/car/preview-x1.mjs docs/3d-upgrade/step03-2 \"selftest=1=vfx_selftest\"",
    "test:env": "node --experimental-transform-types --no-warnings tests/env.test.ts",
    "test:airdash": "node --experimental-transform-types --no-warnings tests/airdash.test.ts",
    "test:envshots": "node scripts/env/preview-env.mjs docs/3d-upgrade/step04 \"test=1=env_selftest\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "0.169.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
